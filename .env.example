# Application Configuration
APP_NAME=LegalAI-Contract-Reviewer
ENVIRONMENT=development
PORT=8000
DEBUG=True

# LLM & Embeddings Provider Options (OpenAI / Gemini / Claude / Local Ollama)
LLM_PROVIDER=openai  # Options: openai, gemini, claude, local
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-m3  # Or text-embedding-3-small, vietnamese-sbert
LLM_MODEL=gpt-4o-mini        # Or qwen2.5:14b, claude-3-5-sonnet

# Database & Storage
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/legal_ai_db
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalpassword123
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword123
MINIO_BUCKET_NAME=contracts
